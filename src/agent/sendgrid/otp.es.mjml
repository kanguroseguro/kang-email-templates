<mjml>
  <mj-head>
    <mj-include path="../../shared/components/head.mjml" />
    <mj-preview>Tu contraseña de un solo uso para Kanguro</mj-preview>
  </mj-head>

  <mj-body background-color="#FFFFFF">

    <mj-include path="../../shared/components/header.es.mjml" />

    <!-- Main Content Section -->
    <mj-section background-color="#FFFFFF" padding="40px 30px 20px">
      <mj-column>

        <!-- Heading -->
        <mj-text css-class="heading-1" align="left">
          Tu Contraseña de Un Solo Uso
        </mj-text>

        <!-- Intro Message -->
        <mj-text css-class="body-text" padding-bottom="20px">
          Usa el código de abajo para iniciar sesión en tu cuenta de Kanguro:
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- OTP Code Box -->
    <mj-section background-color="#F5F2ED" padding="40px 20px">
      <mj-column>
        <mj-text align="center" font-size="40px" font-weight="800" color="#002454" letter-spacing="10px" padding="10px 0">
          {{otpCode}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Continue Main Content -->
    <mj-section background-color="#FFFFFF" padding="30px 30px 40px">
      <mj-column>

        <!-- Expiration Notice -->
        <mj-text css-class="body-text" padding-bottom="20px">
          Este código expirará en <strong>10 minutos</strong> por tu seguridad.
        </mj-text>

        <!-- Security Notice -->
        <mj-text css-class="body-text">
          Si no solicitaste este código, ignora este correo electrónico o contacta a nuestro equipo de soporte si tienes inquietudes sobre la seguridad de tu cuenta.
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-include path="../../shared/components/footer.es.mjml" />

  </mj-body>
</mjml>
