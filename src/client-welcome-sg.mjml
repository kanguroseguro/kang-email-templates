<mjml>
  <mj-head>
    <mj-include path="./components/head.mjml" />
    <mj-font name="Merriweather" href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700;900&display=swap" />
    <mj-font name="Atkinson Hyperlegible Next" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@200;300;400;500;600;700;800&display=swap" />
    <!--
      SendGrid dynamic template variables:
        customer     — full customer name (string)
        policyCount  — integer, number of policies
        isFirst      — boolean (policyCount == 1), computed by the backend
        magicLink    — URL for the app deep-link / magic login link
        policies     — array of:
          { type: "pet"|"renters", name: <petname|address>, id: <ci_id>, startdate: "dd-MM-yyyy" }
    -->
    <mj-preview>
      {{#if isFirst}}Welcome to Kanguro — your policy is active{{/if}}{{#unless isFirst}}Your new policies are ready{{/unless}}
    </mj-preview>
    <mj-style>
      /* Hero tongue shape - rounded bottom corners */
      .hero-tongue,
      .hero-tongue > table,
      .hero-tongue > table > tbody > tr > td {
        border-radius: 0 0 80px 80px !important;
      }

      @media only screen and (max-width: 480px) {
        .hero-tongue,
        .hero-tongue > table,
        .hero-tongue > table > tbody > tr > td {
          border-radius: 0 0 40px 40px !important;
        }
        .hero-tongue-wrapper > table > tbody > tr > td {
          padding-left: 8px !important;
          padding-right: 8px !important;
        }
        .hero-tongue > table > tbody > tr > td {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .hero-greeting div { font-size: 32px !important; }
        .hero-intro div { padding-left: 0 !important; padding-right: 0 !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#FFFFFF">

    <!-- ============ HERO TONGUE ============ -->
    <mj-section background-color="#FFFFFF" padding="0 24px" css-class="hero-tongue-wrapper">
      <mj-column background-color="#4139E0" css-class="hero-tongue" padding="32px 30px 40px">

        <!-- Logo + Website Link -->
        <mj-text padding="0 0 16px" color="#FFFFFF">
          <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
            <tr>
              <td width="60%" style="vertical-align: top;">
                <img src="https://kang-email-templates.vercel.app/assets/kanguro-logo-white.png" width="116" height="39" alt="Kanguro" style="display: block;" />
                <div style="font-family: 'Merriweather', Arial, sans-serif; font-size: 10px; color: #FFFFFF; padding-top: 2px;">Pet &amp; Renters Insurance</div>
              </td>
              <td width="40%" style="vertical-align: bottom; text-align: right;">
                <a href="https://kanguroinsurance.com" style="font-family: 'Merriweather', Arial, sans-serif; font-size: 12px; font-weight: 700; color: #FFFFFF; text-decoration: none; white-space: nowrap;">kanguroinsurance.com</a>
              </td>
            </tr>
          </table>
        </mj-text>

        <!-- Coral Divider -->
        <mj-divider border-width="2px" border-color="#FF703C" padding="0 0 24px" />

        <!-- Greeting -->
        <mj-text align="center" css-class="hero-greeting" color="#FFFFFF" font-size="42px" font-weight="800" line-height="0.95" padding="0 0 24px" font-family="'Merriweather', Arial, serif">
          Hi {{customer.name}},<br/>welcome to <span style="color: #FF703C;">Kanguro!</span>
        </mj-text>

        <!-- Intro text -->
        <mj-text align="center" css-class="hero-intro" color="#FFFFFF" font-size="16px" font-weight="400" line-height="1.3" padding="0 30px 8px" font-family="'Atkinson Hyperlegible Next', 'Helvetica Neue', Arial, sans-serif">
          Thank you for trusting us to protect what matters most. Here {{#if isFirst}}is your active policy{{/if}}{{#unless isFirst}}are your active policies{{/unless}}:
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- ============ POLICY DOCS NOTICE ============ -->
    <mj-section background-color="#FFFFFF" padding="40px 30px 10px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="800" font-family="'Merriweather', Arial, sans-serif" color="#1E1E1E" padding="0 0 16px">
          Your policy docs are on the way
        </mj-text>
        <mj-text align="center" css-class="body-text" padding="0 10px 20px">
          Your policy documents will arrive in a separate email shortly. In the meantime, get started with the Kanguro app!
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#FFFFFF" padding="0 30px 10px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#E0DDD8" padding="0" />
      </mj-column>
    </mj-section>

    <!-- ============ POLICIES TABLE ============ -->
    <mj-section background-color="#FFFFFF" padding="24px 30px 8px">
      <mj-column>
        <mj-raw>
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="vertical-align:top;" width="100%">
          <tbody>
            <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:collapse;">
              <!-- Table header -->
              <thead>
                <tr style="background-color:#EEEEFF;">
                  <th style="padding:12px 16px; text-align:left; font-family:'Atkinson Hyperlegible Next',Arial,sans-serif; font-size:12px; font-weight:700; color:#1E1E1E; text-transform:uppercase; letter-spacing:0.5px; border-radius:4px 0 0 0;">Policy ID</th>
                  <th style="padding:12px 16px; text-align:left; font-family:'Atkinson Hyperlegible Next',Arial,sans-serif; font-size:12px; font-weight:700; color:#1E1E1E; text-transform:uppercase; letter-spacing:0.5px;">Pet / Address</th>
                  <th style="padding:12px 16px; text-align:left; font-family:'Atkinson Hyperlegible Next',Arial,sans-serif; font-size:12px; font-weight:700; color:#1E1E1E; text-transform:uppercase; letter-spacing:0.5px; border-radius:0 4px 0 0;">Start Date</th>
                </tr>
              </thead>
              <tbody>
                {{#each policies}}
                  <tr style="background-color:{{#if @odd}}#F5F2ED{{/if}}{{#unless @odd}}#FFFFFF{{/unless}}; border-bottom:1px solid #E0DDD8;">
                    <td style="padding:14px 16px; font-family:'Atkinson Hyperlegible Next','Helvetica Neue',Arial,sans-serif; font-size:14px; color:#1E1E1E; font-weight:700; white-space:nowrap;">{{this.id}}</td>
                    <td style="padding:14px 16px; font-family:'Atkinson Hyperlegible Next','Helvetica Neue',Arial,sans-serif; font-size:14px; color:#1E1E1E;">
                      <span style="display:inline-block; margin-right:6px; padding:2px 7px; border-radius:20px; font-size:10px; font-weight:700; font-family:'Atkinson Hyperlegible Next',Arial,sans-serif; text-transform:uppercase; letter-spacing:0.3px; background-color:#FF6B52; color:#FFE8E4;">{{this.type}}</span>{{this.name}}
                    </td>
                    <td style="padding:14px 16px; font-family:'Atkinson Hyperlegible Next','Helvetica Neue',Arial,sans-serif; font-size:14px; color:#1E1E1E; white-space:nowrap;">{{this.startdate}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </tbody>
        </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- ============ MAGIC LINK CTA ============ -->
    <mj-section background-color="#FFFFFF" padding="32px 30px 16px">
      <mj-column>

        <mj-raw>
          {{#if magicLink}}
          <tr>
            <td align="center" style="font-size:0px;padding:20px 0;word-break:break-word;">
              <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;">
                <tbody>
                  <tr>
                    <td align="center" bgcolor="#FF703C" role="presentation" style="border:none;border-radius:100px;cursor:auto;mso-padding-alt:10px 25px;background:#FF703C;" valign="middle">
                      <a href="{{magicLink}}" style="display:inline-block;background:#4139E0;color:#FFFFFF;font-family:'Atkinson Hyperlegible Next','Helvetica Neue',Arial,sans-serif;font-size:13px;font-weight:400;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:100px;" target="_blank">Open the Kanguro App</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
          {{/if}}
        </mj-raw>

      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#FFFFFF" padding="16px 30px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#E0DDD8" padding="0" />
      </mj-column>
    </mj-section>

    <!-- ============ FOOTER ============ -->
    <mj-include path="./components/footer.mjml" />

  </mj-body>
</mjml>
